{
  "name": "personal-hub-api",
  "version": "1.0.0",
  "description": "personal-hub-api",
  "main": "index.js",
  "prisma": {
    "schema": "./prisma/schema.prisma",
    "seed": "ts-node prisma/seed.ts"
  },
  "scripts": {
    "start": "node build/main.js",
    "start:dev": "tsx watch src/main.ts",
    "test:create-prisma-environment": "npm link ./prisma/vitest-environment-prisma",
    "test:install-prisma-environment": "npm link vitest-environment-prisma",
    "build": "tsup src --out-dir build",
    "test": "vitest run --dir src/domain/application/use-cases",
    "test:watch": "vitest --dir src/domain/application/use-cases",
    "pretest:e2e": "run-s test:create-prisma-environment test:install-prisma-environment",
    "test:e2e": "vitest run --dir src/infra/http",
    "test:coverage": "vitest --coverage",
    "lint": "eslint . --ext .js,.ts",
    "lint:fix": "eslint . --ext .js,.ts --fix",
    "training-to-expire-in-7-days": "npx ts-node src/infra/integration/default/training-to-expire-in-7-days.ts",
    "document-to-expire-in-7-days": "npx ts-node src/infra/integration/default/document-to-expire-in-7-days.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@rocketseat/eslint-config": "^2.2.2",
    "@types/bcryptjs": "2.4.6",
    "@types/mime-types": "^2.1.4",
    "@types/node": "^20.12.8",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "6.4.15",
    "@types/pg": "^8.16.0",
    "@types/supertest": "6.0.2",
    "@typescript-eslint/parser": "6.21.0",
    "@vitest/coverage-v8": "^1.6.0",
    "eslint": "^8.57.0",
    "eslint-plugin-simple-import-sort": "12.1.0",
    "npm-run-all": "4.1.5",
    "prettier-eslint": "^16.4.2",
    "prisma": "^7.4.1",
    "studio": "^0.13.5",
    "supertest": "7.0.0",
    "tsx": "^4.9.3",
    "typescript": "^5.4.5",
    "vite-tsconfig-paths": "4.3.2"
  },
  "dependencies": {
    "@fastify/cookie": "9.3.1",
    "@fastify/cors": "9.0.1",
    "@fastify/helmet": "^13.0.1",
    "@fastify/jwt": "8.0.1",
    "@fastify/multipart": "8.2.0",
    "@google-cloud/storage": "^7.15.0",
    "@prisma/adapter-pg": "^7.4.1",
    "@prisma/client": "^7.4.1",
    "axios": "^1.8.4",
    "bcryptjs": "2.4.3",
    "dayjs": "1.11.11",
    "dotenv": "16.4.5",
    "esbuild": "0.25.1",
    "fastify": "^4.26.2",
    "i": "0.3.7",
    "magic-bytes.js": "^1.10.0",
    "media-metadata": "^2.1.0",
    "music-metadata": "^11.0.2",
    "node-cron": "^4.2.1",
    "nodemailer": "6.9.13",
    "npm": "10.7.0",
    "pdf-lib": "^1.17.1",
    "redis": "^4.7.0",
    "ts-node": "^10.9.2",
    "tsup": "^8.3.5",
    "video-metadata-thumbnails": "^1.0.22",
    "vitest": "^1.6.0",
    "xlsx": "^0.18.5",
    "zod": "3.23.6",
    "zod-validation-error": "3.2.0"
  }
}